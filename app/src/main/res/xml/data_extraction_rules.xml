<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes into a backup or a device transfer: saved servers hold passwords encrypted with a
     key that never leaves this phone's keystore, so a copy would be useless anywhere else. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
